APP_NAME=Campus Incidents API
APP_ENV=development
APP_DEBUG=false
AUTO_CREATE_SCHEMA=false
#DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/campus_incidents
DATABASE_URL=postgresql+psycopg2://campus_app:CHANGE_ME@localhost:5432/campus_incidents

CORS_ORIGINS=http://localhost:3000

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXP_MINUTES=480
SESSION_COOKIE_NAME=campus_session
CSRF_COOKIE_NAME=campus_csrf
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
TRUSTED_HOSTS=localhost,127.0.0.1
ALLOWED_EMAIL_DOMAINS=example.edu

# Set these in production; Turnstile is required when REQUIRE_TURNSTILE=true.
TURNSTILE_SECRET_KEY=
REQUIRE_TURNSTILE=false
RATE_LIMIT_LOGIN=5
RATE_LIMIT_PUBLIC_REPORT=3

LOCAL_STORAGE_PATH=./data/evidences
MAX_IMAGE_SIZE_MB=10
MAX_IMAGE_PIXELS=25000000

# TokenRouter is OpenAI-compatible. Do not commit the key; configure it as a
# Render secret. The last model is paid and is reached only after the two free
# VLMs fail; cap its TokenRouter monthly budget in the provider dashboard.
AI_TOKENROUTER_API_KEY=
AI_TOKENROUTER_BASE_URL=https://api.tokenrouter.com/v1
AI_IMAGE_PRIMARY_MODEL=moonshotai/kimi-k3-free
AI_IMAGE_FALLBACK_MODELS=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,qwen/qwen3.5-9b
AI_PROMPT_VERSION=incident-classification-v2
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=700

BREVO_API_KEY=
BREVO_FROM_EMAIL=alerts@example.edu
BREVO_FROM_NAME=Campus Alertas

DEFAULT_ALERT_EMAIL=seguridad@example.edu
DASHBOARD_BASE_URL=http://localhost:3000/dashboard
FRONTEND_BASE_URL=http://localhost:3000

WORKER_POLL_SECONDS=2
CLASSIFICATION_RETRY_DELAY_SECONDS=120
NOTIFICATION_RETRY_DELAY_SECONDS=60
JOB_LEASE_SECONDS=300
RETENTION_DAYS=180
# Optional encrypted external backup. Configure AWS_ACCESS_KEY_ID,
# AWS_SECRET_ACCESS_KEY, BACKUP_S3_BUCKET and (for R2) AWS_ENDPOINT_URL.
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=campus-evidences

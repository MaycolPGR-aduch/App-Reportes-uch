[Unit]
Description=Run Campus Alertas Alembic migrations
Wants=network-online.target
Requires=postgresql.service
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=campus-alertas
Group=campus-alertas
WorkingDirectory=/opt/campus-alertas/current/backend
EnvironmentFile=/etc/campus-alertas/app.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/campus-alertas/venv/bin/alembic -c alembic.ini upgrade head
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

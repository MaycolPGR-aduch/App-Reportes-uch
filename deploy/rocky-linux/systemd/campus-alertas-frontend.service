[Unit]
Description=Campus Alertas Next.js frontend
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=campus-alertas
Group=campus-alertas
WorkingDirectory=/opt/campus-alertas/current/frontend
Environment=NODE_ENV=production
ExecStart=/usr/bin/npm run start -- --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
